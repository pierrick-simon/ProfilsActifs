generator client {
  provider = "prisma-client"
  output   = "prisma"
}

datasource db {
  provider = "postgresql"
}

model account {
  id                    String    @id
  userId                String
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @db.Timestamptz(6)
  updatedAt             DateTime  @db.Timestamptz(6)
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model like {
  id                          String   @id
  likedUserId                 String
  likerUserId                 String
  timestamp                   DateTime @db.Timestamptz(6)
  user_like_likedUserIdTouser user     @relation("like_likedUserIdTouser", fields: [likedUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_like_likerUserIdTouser user     @relation("like_likerUserIdTouser", fields: [likerUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([likedUserId, likerUserId])
  @@index([id], map: "like_identifier_idx")
}

model message {
  id                            String    @id
  senderid                      String?
  receiverid                    String?
  content                       String?
  timestamp                     DateTime? @db.Timestamptz(6)
  user_message_receiveridTouser user?     @relation("message_receiveridTouser", fields: [receiverid], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_message_senderidTouser   user?     @relation("message_senderidTouser", fields: [senderid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id], map: "message_identifier_idx")
}

model quiz {
  userId String @id

  @@index([userId], map: "quiz_identifier_idx")
}

model session {
  id             String   @id
  userId         String
  token          String   @unique
  expiresAt      DateTime @db.Timestamptz(6)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @db.Timestamptz(6)
  updatedAt      DateTime @db.Timestamptz(6)
  impersonatedBy String?
  user           user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model user {
  id                               String    @id
  name                             String
  email                            String    @unique
  emailVerified                    Boolean
  image                            String?
  createdAt                        DateTime  @db.Timestamptz(6)
  updatedAt                        DateTime  @db.Timestamptz(6)
  acceptedTerms                    Boolean
  role                             String?
  banned                           Boolean?
  banReason                        String?
  banExpires                       DateTime? @db.Timestamptz(6)
  account                          account[]
  like_like_likedUserIdTouser      like[]    @relation("like_likedUserIdTouser")
  like_like_likerUserIdTouser      like[]    @relation("like_likerUserIdTouser")
  message_message_receiveridTouser message[] @relation("message_receiveridTouser")
  message_message_senderidTouser   message[] @relation("message_senderidTouser")
  session                          session[]
  video                            video[]
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @db.Timestamptz(6)
  updatedAt  DateTime @db.Timestamptz(6)

  @@index([identifier])
}

model video {
  id        String  @id
  url       String
  userId    String
  views     Int
  validated Boolean
  user      user    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id], map: "video_identifier_idx")
}
