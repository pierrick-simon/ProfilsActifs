generator client {
  provider = "prisma-client"
  output   = "prisma"
}

datasource db {
  provider = "postgresql"
}

model account {
  id                    String    @id
  user                  user      @relation(fields: [userId], references: [id])
  userId                String
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @db.Timestamptz(3)
  updatedAt             DateTime  @db.Timestamptz(3)

  @@index([userId], map: "account_userId_idx")
}

model like {
  id                          String   @id
  likedUserId                 String
  likerUserId                 String
  timestamp                   DateTime @db.Timestamptz(6)
  user_like_likedUserIdTouser user     @relation("like_likedUserIdTouser", fields: [likedUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_like_likerUserIdTouser user     @relation("like_likerUserIdTouser", fields: [likerUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([likedUserId, likerUserId])
}

model message {
  id                            String    @id
  senderid                      String?
  receiverid                    String?
  content                       String?
  timestamp                     DateTime? @db.Timestamptz(6)
  user_message_receiveridTouser user?     @relation("message_receiveridTouser", fields: [receiverid], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_message_senderidTouser   user?     @relation("message_senderidTouser", fields: [senderid], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  SELECT
  RADIO
  CHECKBOX
  DATE
}

model question {
  id           String         @id
  name         String         @unique
  type         FieldType
  required     Boolean
  options      Json?
  order        Int?
  createdAt    DateTime       @db.Timestamptz(6)
  updatedAt    DateTime       @db.Timestamptz(6)
  archived     Boolean        @default(false)
  formResponse formResponse[]
}

model formResponse {
  id         String   @id
  userId     String
  questionId String
  response   Json
  createdAt  DateTime @db.Timestamptz(6)
  updatedAt  DateTime @db.Timestamptz(6)
  archived   Boolean  @default(false)
  question   question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([questionId])
}

model session {
  id        String   @id
  user      user     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)

  impersonatedBy String?

  @@index([userId], map: "session_userId_idx")
}

model skill {
  id        String      @id
  name      String      @unique
  createdAt DateTime    @db.Timestamptz(6)
  updatedAt DateTime    @db.Timestamptz(6)
  userSkill userSkill[]
}

model userSkill {
  id        String   @id
  userId    String
  skillId   String
  createdAt DateTime @db.Timestamptz(6)
  skill     skill    @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model user {
  id             String          @id
  name           String
  email          String          @unique
  emailVerified  Boolean
  image          String?
  createdAt      DateTime        @db.Timestamptz(3)
  updatedAt      DateTime        @db.Timestamptz(3)
  acceptedTerms  Boolean
  dateOfBirth    DateTime?       @db.Timestamptz(3)
  localisation   String
  dateOfBirth    DateTime        @db.Date
  role           String?
  banned         Boolean?
  banReason      String?
  banExpires     DateTime?       @db.Timestamptz(3)
  activitySector ActivitySector?

  account                          account[]
  like_like_likedUserIdTouser      like[]         @relation("like_likedUserIdTouser")
  like_like_likerUserIdTouser      like[]         @relation("like_likerUserIdTouser")
  message_message_receiveridTouser message[]      @relation("message_receiveridTouser")
  message_message_senderidTouser   message[]      @relation("message_senderidTouser")
  session                          session[]
  video                            video[]
  userSkill                        userSkill[]
  formResponse                     formResponse[]
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)

  @@index([identifier], map: "verification_identifier_idx")
}

enum ActivitySector {
  TECHNOLOGY
  FINANCE
  HEALTHCARE
  EDUCATION
  RETAIL
  MANUFACTURING
  CONSULTING
  MEDIA
  GOVERNMENT
  OTHER
}

model video {
  id        String  @id
  url       String
  userId    String
  views     Int
  validated Boolean
  user      user    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}
